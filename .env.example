# ==============================================================================
# Copy to .env and fill in. Used by docker compose (interpolation) and by the Python
# settings when running locally. Never commit .env.
# ==============================================================================

# ---- Required by docker compose ----------------------------------------------
# Absolute path of the Dunnhumby "The Complete Journey" CSV folder on the host (mounted read-only).
RAW_DATA_DIR=/absolute/path/to/dunnhumby_The-Complete-Journey CSV
# Comma-separated API keys for write/admin/bulk endpoints (X-API-Key header). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVING_API_KEYS=
GRAFANA_ADMIN_PASSWORD=

# ---- Application -------------------------------------------------------------
ENV=production
LOG_LEVEL=INFO
# true = no silent in-memory fallbacks: fail fast if Redis is unreachable.
# Set to false for local development without Redis.
STRICT_INFRA=true
RATE_LIMIT_PER_MINUTE=600
AUTO_RETRAIN_ON_DEGRADATION=true

# ---- Local (non-docker) runs ---------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
DATA_RAW_DIR=sample_data/dunnhumby
LAKEHOUSE_PATH=data/lakehouse/propensity_warehouse.duckdb
MODEL_PATH=models/champion_model.joblib

# ---- Host port overrides (optional) ---------------------------------------------
# SERVING_HOST_PORT=8000
# REDIS_HOST_PORT=6379
# PROMETHEUS_HOST_PORT=9090
# ALERTMANAGER_HOST_PORT=9093
# GRAFANA_HOST_PORT=3000

