# ==============================================================================
# ENVIRONMENT CONFIGURATION: ON-PREMISE LAMBDA ARCHITECTURE STACK
# ==============================================================================

# Application Environment
ENV=production
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# Master Dataset (MinIO S3 On-Premise / GCS Cloud)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_MASTER=lakehouse-master
S3_REGION=us-east-1
S3_SECURE=false

# OLTP Database (PostgreSQL HA)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=propensity_oltp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pwd

# Speed & Serving Layer Cache (Redis Cluster / Dragonfly)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Lakehouse Storage
LAKEHOUSE_PATH=data/lakehouse/propensity_warehouse.duckdb
DATA_RAW_DIR=sample_data/dunnhumby
MODEL_PATH=models/champion_model.joblib

# Serving API hardening
# Comma-separated API keys for write/admin/bulk endpoints (X-API-Key header). Generate e.g. with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVING_API_KEYS=
RATE_LIMIT_PER_MINUTE=600
# true = no silent in-memory fallbacks; the service fails fast if Redis/Kafka are unreachable
STRICT_INFRA=true

# Lambda fusion heuristics (not learned; recalibrate from feedback data)
FUSION_PURCHASE_DAMPENING=0.25
FUSION_COUPON_BOOST_PER_CLIP=0.15
FUSION_APP_NUDGE=0.05
FUSION_APP_MIN_INTERACTIONS=2
